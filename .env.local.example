# Slack Incoming Webhook URL used to notify the team of new script submissions.
# Create one at https://api.slack.com/apps -> your app -> Incoming Webhooks.
SLACK_WEBHOOK_URL=

# Supabase project — Settings -> API in your Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY is secret: it bypasses row-level security.
# Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
