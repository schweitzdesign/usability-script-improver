# Supabase project — Settings -> API in your Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY is secret: it bypasses row-level security.
# Never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for script grading and chat. Get one at https://console.anthropic.com.
# Server-only — never expose to the browser or prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Resend sends the feedback confirmation email. Get a key at https://resend.com.
# FEEDBACK_FROM_EMAIL must be a verified sender (until you verify a domain,
# onboarding@resend.dev works but can only email your own Resend account address).
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=

# Agent API: the Hermes bots call /api/agent/* with this bearer token.
# Generate one with: openssl rand -hex 32. Server-only, never expose to the browser.
AGENT_API_TOKEN=
# "draft" (default) stores Support replies without emailing them; "send" emails them for real.
AGENT_REPLY_MODE=draft

# Where replies to POKE's emails should land (your real inbox). Without it,
# "just reply to this email" goes to the sender address, which can't receive mail.
FEEDBACK_REPLY_TO=

# Monthly dollar cap for the agent team, shown on every PM recommendation. Defaults to 30,
# the cap on the Hermes workspace in the Anthropic Console.
AGENT_MONTHLY_BUDGET_USD=30
