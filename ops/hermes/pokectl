def ship_enabled():
    """Automatic shipping is on only when both the switch and the GitHub token are set."""
    return os.environ.get("POKECTL_SHIP") == "on" and bool(os.environ.get("GITHUB_DISPATCH_TOKEN"))


def dispatch_ship(item_number):
    """Start the GitHub build workflow for one item. Returns (ok, error_text)."""
    request = urllib.request.Request(
        f"https://api.github.com/repos/{GITHUB_REPO}/actions/workflows/ship.yml/dispatches",
        data=json.dumps({"ref": "main", "inputs": {"item": str(item_number)}}).encode(),
        method="POST",
        headers={
            "Authorization": f"Bearer {os.environ['GITHUB_DISPATCH_TOKEN']}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "pokectl/1",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=25) as response:
            return response.status == 204, f"HTTP {response.status}"
    except urllib.error.HTTPError as error:
        return False, f"GitHub said HTTP {error.code}"
    except urllib.error.URLError as error:
        return False, f"could not reach GitHub: {error.reason}"


def ship_builds(args):
    """Start the build for each approved change, exactly once."""
    items = ok_or_fail(*call("GET", "/backlog?needs_ship=1&limit=5"))["items"]
    for i in items:
        n = i["item_number"]
        label = item_label(n)
        if not ship_enabled():
            print(f"{label}: approved, but automatic shipping is off, so it stays manual")
            continue
        if args.dry_run:
            print(f"would start building {label}")
            continue
        status, started = call("POST", f"/backlog/{n}/ship", {"action": "start"})
        if status == 409:
            print(f"{label}: already started, skipping")
            continue
        ok_or_fail(status, started)
        sent, detail = dispatch_ship(n)
        if not sent:
            call("POST", f"/backlog/{n}/ship", {"action": "fail", "note": f"The build could not be started: {detail}. Nothing was changed on the live site."})
            print(f"{label}: could not start the build: {detail}", file=sys.stderr)
            continue
        print(f"{label}: build started (auto-merge {'on' if started.get('auto_merge') else 'off: ' + ' '.join(started.get('reasons', []))})")
    if not items:
        print("no approved changes waiting to be built")


def compose_ship_message(item):
    """Tell Zach how a build ended, in plain words."""
    label, title = item_label(item["item_number"]), item["title"]
    state, note, pr = item["ship_state"], item.get("ship_note") or "", item.get("pr_url") or ""
    if state == "live":
        lines = [f"{label} is live in production: {title}.", ""]
        if item.get("change_summary"):
            lines += [item["change_summary"], ""]
        lines.append("Refresh the site to see it.")
        if pr:
            lines.append(f"What changed: {pr}")
        lines.append("To undo it, use Instant Rollback in Vercel, or revert that pull request.")
        return "\n".join(lines)
    if state == "needs_review":
        lines = [f"{label} is built but needs your review before it goes live: {title}.", ""]
        if note:
            lines += [note, ""]
        if pr:
            lines.append(f"Pull request: {pr}")
        lines.append("Merge it on GitHub when you're happy, and I'll tell you when it's live.")
        return "\n".join(lines)
    lines = [f"{label} could not be built: {title}.", ""]
    if note:
        lines += [note, ""]
    lines.append("Nothing was changed on the live site.")
    return "\n".join(lines)


def report_ship(dry_run=False):
