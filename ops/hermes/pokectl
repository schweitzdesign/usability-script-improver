def queue_engineering(args):
    """Create the Design-Engineer's board task, and the PM's finalize task behind it, for each item that needs one."""
    items = ok_or_fail(*call("GET", "/backlog?status=assessing&limit=20"))["items"]
    refreshed = False
    for i in items:
        n = i["item_number"]
        label = item_label(n)
        detail = fetch_item(n)
        a = detail.get("assessment")
        decided = i.get("decided_at")
        # An assessment older than the Director's last decision is stale: "Ask more" reopened the item.
        current = bool(a) and (not decided or a["created_at"] > decided)
        if not current:
            kind, epoch = "assess", re.sub(r"\W", "", decided or "first")
        elif i.get("followup_question") and not i.get("followup_answer"):
            kind, epoch = "followup", "fu"
        else:
            continue
        if args.dry_run:
            print(f"would queue the Design-Engineer ({kind}) for {label}")
            continue
        if not refreshed:
            refresh_repo()
            refreshed = True

        title = one_line(i["title"], 40)
        if kind == "assess":
            eng_body = (
                f"Assess backlog item {label}. Follow your SOUL.md: read it with backlog_get, read the real code with the "
                "repo tools, then call submit_assessment. If the item shows a decision note from the Director, that is the "
                "question to answer. Finish with a one-line summary beginning [Eng]."
            )
            eng_title, final_title = f"Eng {label} assess: {title}", f"PM {label} finalize: {title}"
            final_body = (
                f"Finalize backlog item {label} now that the Design-Engineer has assessed it. Follow the finalize steps in "
                "your SOUL.md. Finish with a one-line summary beginning [PM]."
            )
        else:
            eng_body = (
                f"The PM has one follow-up question on {label}. Read it with backlog_get (see followup_question), look at "
                "the code again if you need to, and answer with answer_followup in a few plain sentences. Finish with a "
                "one-line summary beginning [Eng]."
            )
            eng_title, final_title = f"Eng {label} follow-up: {title}", f"PM {label} finalize (round 2): {title}"
            final_body = (
                f"Finalize backlog item {label} again now that the Design-Engineer has answered your follow-up. This is the "
                "last round: recommend now. Finish with a one-line summary beginning [PM]."
            )
        result, eng_task = create_task(eng_title, "eng", f"poke-eng-{kind}-{n}-{epoch}", eng_body, "20m")
        if result.returncode != 0 or not eng_task:
            print(f"{label}: could not create the Design-Engineer task: {one_line(result.stderr or result.stdout, 200)}", file=sys.stderr)
            continue
        result, pm_task = create_task(final_title, "pm", f"poke-pm-final-{kind}-{n}-{epoch}", final_body, parents=[eng_task])
        if result.returncode != 0:
            print(f"{label}: could not create the PM finalize task: {one_line(result.stderr or result.stdout, 200)}", file=sys.stderr)
            continue
        print(f"{label}: Design-Engineer {kind} queued as task {eng_task}, PM finalize waits on it")
    if not items:
        print("no items waiting for the Design-Engineer")


