def run_command(fn, **kwargs):
    """Run a command function and return what it printed. Failures raise ToolError."""
    buffer = io.StringIO()
    with contextlib.redirect_stdout(buffer):
        fn(argparse.Namespace(**kwargs))
    return buffer.getvalue().strip() or "done"


def require(arguments, *names):
    missing = [n for n in names if arguments.get(n) in (None, "")]
    if missing:
