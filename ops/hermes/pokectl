        sys.exit(2)
    tools = {t["name"]: t for t in ROLE_TOOLS[role]}
    out = sys.stdout  # only JSON-RPC may ever be written here

    def send(message):
        out.write(json.dumps(message) + "\n")
        out.flush()

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        msg_id, method, params = msg.get("id"), msg.get("method"), msg.get("params") or {}
        if msg_id is None:  # notifications need no reply
            continue

        if method == "initialize":
            asked = params.get("protocolVersion")
            version = asked if asked in MCP_PROTOCOL_VERSIONS else MCP_PROTOCOL_VERSIONS[0]
            send({"jsonrpc": "2.0", "id": msg_id, "result": {
                "protocolVersion": version,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": f"pokectl-{role}", "version": "1"},
            }})
        elif method == "ping":
            send({"jsonrpc": "2.0", "id": msg_id, "result": {}})
        elif method == "tools/list":
            listing = [{k: t[k] for k in ("name", "description", "inputSchema")} for t in tools.values()]
            send({"jsonrpc": "2.0", "id": msg_id, "result": {"tools": listing}})
        elif method == "tools/call":
            tool = tools.get(params.get("name"))
            if not tool:
                send({"jsonrpc": "2.0", "id": msg_id, "error": {"code": -32602, "message": f"unknown tool: {params.get('name')}"}})
                continue
            try:
                text, is_error = tool["handler"](params.get("arguments") or {}), False
            except ToolError as error:
                text, is_error = f"ERROR: {error}", True
            except Exception as error:  # a bug in a tool must not kill the server
                text, is_error = f"ERROR: tool failed: {error}", True
            send({"jsonrpc": "2.0", "id": msg_id, "result": {"content": [{"type": "text", "text": text}], "isError": is_error}})
        else:
            send({"jsonrpc": "2.0", "id": msg_id, "error": {"code": -32601, "message": f"method not found: {method}"}})


def main():
    load_config()
    parser = argparse.ArgumentParser(prog="pokectl", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("policy", help="response windows, tone, FAQ").set_defaults(fn=cmd_policy)

    ticket = sub.add_parser("ticket", help="read and update tickets").add_subparsers(dest="action", required=True)
    get = ticket.add_parser("get", help="show one ticket")
    get.add_argument("number")
    get.set_defaults(fn=cmd_ticket_get)

    recent = ticket.add_parser("recent", help="one line per recent ticket, to spot duplicates")
    recent.add_argument("--limit", type=int, default=15)
    recent.set_defaults(fn=cmd_ticket_recent)

    classify = ticket.add_parser("classify", help="record triage")
    classify.add_argument("number")
    classify.add_argument(
        "--class", dest="cls",
        choices=["bug", "usability", "feature_request", "user_error", "question", "not_actionable"],
    )
    classify.add_argument("--severity", choices=["low", "medium", "high", "critical"])
    classify.add_argument("--notes")
    classify.add_argument("--duplicate-of", type=int)
    classify.add_argument("--status", choices=["triaged", "resolved_by_support"])
    classify.add_argument("--actor", default="support-bot")
    classify.set_defaults(fn=cmd_ticket_classify)

    reply = ticket.add_parser("reply", help="record or send a reply to the user")
    reply.add_argument("number")
    reply.add_argument("--body", required=True)
    reply.add_argument("--actor", default="support-bot")
    reply.set_defaults(fn=cmd_ticket_reply)

    story = ticket.add_parser("story", help="the full story of a ticket: user words, reply, triage, timeline")
    story.add_argument("number", nargs="?")
    story.add_argument("--since", help="tickets created in the last N minutes, hours, or days, like 2h")
    story.add_argument("--all", action="store_true", help="the 50 newest tickets")
    story.set_defaults(fn=cmd_ticket_story)

    backlog = sub.add_parser("backlog", help="read the PM's backlog").add_subparsers(dest="action", required=True)
    blist = backlog.add_parser("list", help="one line per item, best score first")
    blist.add_argument("--limit", type=int, default=30)
    blist.add_argument("--status")
    blist.set_defaults(fn=cmd_backlog_list)
    bget = backlog.add_parser("get", help="show one item in full")
    bget.add_argument("number")
    bget.set_defaults(fn=cmd_backlog_get)

    sub.add_parser("budget", help="month-to-date spend against the agent budget").set_defaults(fn=cmd_budget)

    sync = sub.add_parser("sync", help="queue new tickets, send finished-ticket cards, alert on stuck tasks")
    sync.add_argument("--dry-run", action="store_true")
    sync.add_argument("--limit", type=int, default=10)
    sync.set_defaults(fn=cmd_sync)

    mcp = sub.add_parser("mcp", help="run as an MCP tool server (for Hermes, one role per profile)")
    mcp.add_argument("--role", required=True, choices=sorted(ROLE_TOOLS))
    mcp.set_defaults(fn=lambda a: serve_mcp(a.role))

    report = sub.add_parser("report", help="send cards for finished tickets that haven't had one")
    report.add_argument("--dry-run", action="store_true", help="print the cards instead of sending")
    report.set_defaults(fn=cmd_report)

    usage = sub.add_parser("usage-sync", help="report bot token usage to POKE")
    usage.add_argument("--dry-run", action="store_true")
    usage.set_defaults(fn=cmd_usage_sync)

    args = parser.parse_args()
    if args.command == "ticket" and args.action == "story" and not (args.number or args.since or args.all):
        fail("give a ticket number, or --since 2h, or --all")
    args.fn(args)


if __name__ == "__main__":
    main()
