def load_config():
    try:
        for line in Path(CONFIG_FILE).read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, _, value = line.partition("=")
                os.environ.setdefault(key.strip(), value.strip().strip('"').strip("'"))
    except FileNotFoundError:
        pass


class ToolError(Exception):
    """Raised instead of exiting when running as an MCP server."""


MCP_MODE = False


def fail(message):
    if MCP_MODE:
        raise ToolError(message)
    print(f"ERROR: {message}", file=sys.stderr)
    sys.exit(1)


def call(method, path, body=None):
    base = os.environ.get("POKE_BASE_URL", "").rstrip("/")
    token = os.environ.get("AGENT_API_TOKEN", "")
    if not base or not token:
        fail(f"POKE_BASE_URL and AGENT_API_TOKEN must be set in {CONFIG_FILE}")
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(
        base + "/api/agent" + path,
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "User-Agent": "pokectl/1",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=25) as response:
            return response.status, json.loads(response.read() or b"{}")
    except urllib.error.HTTPError as error:
        try:
            detail = json.loads(error.read()).get("error", "")
        except Exception:
            detail = ""
        return error.code, {"error": detail or f"HTTP {error.code}"}
    except urllib.error.URLError as error:
        fail(f"could not reach POKE: {error.reason}")


def ok_or_fail(status, payload):
    if status >= 400:
        fail(f"{status}: {payload.get('error', 'request failed')}")
    return payload


def one_line(text, limit):
    flat = " ".join(str(text).split())
    return flat if len(flat) <= limit else flat[: limit - 3] + "..."


def ticket_label(number):
    return f"POKE-{int(number):04d}"


def item_label(number):
    return f"B-{int(number):03d}"


EASE_BAND_TEXT = {"S": "8 to 10", "M": "5 to 7", "L": "1 to 4"}
KIND_LABEL = {"bug": "Bug", "usability": "Usability", "feature_request": "Feature request"}
REC_LABEL = {
    "build_now": "Make this change now",
    "build_later": "Make this change later",
    "investigate": "Find out more before changing anything",
    "needs_info": "Find out more before changing anything",
    "defer": "Wait for now",
    "drop": "Make no change",
}
EFFORT_LABEL = {"S": "Small", "M": "Medium", "L": "Large"}
