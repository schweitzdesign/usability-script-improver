def hermes(*argv):
    return subprocess.run(["hermes", *argv], capture_output=True, text=True, timeout=60)


def parse_task_id(stdout):
    try:
        data = json.loads(stdout)
        for key in ("id", "task_id"):
            if isinstance(data, dict) and data.get(key):
                return str(data[key])
        if isinstance(data, dict) and isinstance(data.get("task"), dict):
            return str(data["task"].get("id", "")) or None
    except Exception:
        pass
    return None


def queue_new_tickets(args):
    payload = ok_or_fail(*call("GET", f"/tickets?status=new&limit={args.limit}"))
    tickets = payload["tickets"]
    if not tickets:
